---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Social Circle",
  description = "Social Circle helps Connecticut businesses grow through social media marketing, website development and marketing photography.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9X880345YR" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-9X880345YR");
    </script>
  </head>
  <body id="top" class="bg-black text-white">
    <slot />
  </body>
</html>
