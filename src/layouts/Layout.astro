---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import SiteHealthBeacon from "../components/Sitehealthbeacon.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Social Circle is a Connecticut based digital marketing agency helping small businesses grow with social media marketing, website development and marketing photography.",
  image,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9X880345YR" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-9X880345YR");
    </script>
  </head>
  <body id="top" class="bg-black text-white">
    <SiteHealthBeacon siteId="socialcirclect" />
    <slot />
  </body>
</html>
