---
import Reveal from "./Reveal";
import { services, contact } from "../data/site";
---

<section id="services" class="py-16 px-4 bg-gray-100">
  <div class="max-w-6xl mx-auto text-center">
    <h2 class="text-4xl font-bold text-gray-900 mb-8">Services We Offer</h2>

    <div class="grid md:grid-cols-3 gap-8">
      {
        services.map((service) => (
          <Reveal client:visible x={50} delay={0.2} className="inline-block">
            <div class="h-full bg-white p-6 rounded-2xl shadow-lg border border-gray-200 relative overflow-hidden group">
              <h3 class="text-2xl font-semibold text-gray-800 mb-4">{service.title}</h3>
              <p class="text-gray-600">{service.description}</p>
              <div class="absolute bottom-0 left-1/2 w-0 h-1 bg-purple-500 transition-all duration-300 group-hover:w-full group-hover:left-0" />
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>

  <div class="mt-16 text-center">
    <Reveal client:visible x={-50}>
      <h2 class="text-3xl font-bold text-gray-900">Let’s Create Something Bigger</h2>
    </Reveal>
    <Reveal client:visible x={50} delay={0.2}>
      <a
        href={`mailto:${contact.email}`}
        class="inline-block mt-4 px-6 py-3 text-lg font-semibold text-white bg-purple-600 rounded-full shadow-lg hover:bg-purple-700"
      >
        Start Now
      </a>
    </Reveal>
  </div>
</section>
